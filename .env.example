# MySQL — copy this file to .env and replace placeholders locally.
MYSQL_HOST=db.xjanua.tech
MYSQL_PORT=3306
MYSQL_DATABASE=ai_transwatch
MYSQL_USERNAME=your_mysql_username
MYSQL_PASSWORD=your_mysql_password

# Spring Boot
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
JWT_BASE64_SECRET=replace_with_a_secure_base64_secret_at_least_32_bytes
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173
AI_SERVICE_BASE_URL=http://localhost:8000

# AI service
AI_SERVICE_PORT=8000

# Ngưỡng rule engine cảnh báo (tuỳ chọn; bỏ trống sẽ dùng giá trị mặc định trong code)
ALERTS_SPEED_LIMIT_KMH=80
ALERTS_ROUTE_DEVIATION_METERS=300
ALERTS_ABNORMAL_STOP_MINUTES=15
ALERTS_CONTINUOUS_DRIVING_MINUTES=240
ALERTS_GPS_SIGNAL_TIMEOUT_MINUTES=10
ALERTS_DOCUMENT_EXPIRY_WARNING_DAYS=30
ALERTS_DUPLICATE_SUPPRESSION_HOURS=6
ALERTS_CHECK_INTERVAL_MS=60000
ALERTS_CHECK_INITIAL_DELAY_MS=30000
